PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_strong_jwt_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ── Email Service (required for email verification) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="VoxCode <your_email@gmail.com>"
EMAIL_SECURE=false

# ── AI Models (configure one or more — lowest priority number wins) ──
# The system automatically fails over to the next model if one is rate-limited.
# Rate-limited models sleep for 1 hour, then are health-checked and reactivated.

AI_MODEL_1_PROVIDER=
AI_MODEL_1_NAME=
AI_MODEL_1_API_KEY=
AI_MODEL_1_BASE_URL=
AI_MODEL_1_PRIORITY=1

AI_MODEL_2_PROVIDER=
AI_MODEL_2_NAME=
AI_MODEL_2_API_KEY=
AI_MODEL_2_BASE_URL=
AI_MODEL_2_PRIORITY=2

AI_MODEL_3_PROVIDER=
AI_MODEL_3_NAME=
AI_MODEL_3_API_KEY=
AI_MODEL_3_BASE_URL=
AI_MODEL_3_PRIORITY=3

AI_MODEL_4_PROVIDER=
AI_MODEL_4_NAME=
AI_MODEL_4_API_KEY=
AI_MODEL_4_BASE_URL=
AI_MODEL_4_PRIORITY=4

AI_MODEL_5_PROVIDER=
AI_MODEL_5_NAME=
AI_MODEL_5_API_KEY=
AI_MODEL_5_BASE_URL=
AI_MODEL_5_PRIORITY=5

# ── Legacy single-model fallback (used when no numbered models are configured) ──
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=

# ── Text-to-Speech (optional — browser TTS used as fallback if not configured) ──
# Providers: "openai" | "openai-compatible" | "fish" | "browser"
# - OpenAI: TTS_MODEL=tts-1, TTS_VOICE=alloy|echo|fable|onyx|nova|shimmer
# - Fish Audio: TTS_MODEL=s2-pro|s1|s2.1-pro|s2.1-pro-free,
#   TTS_VOICE=<voice reference_id from the Fish Audio playground>,
#   TTS_BASE_URL=https://api.fish.audio
# If TTS_API_KEY is empty, browser speechSynthesis is used instead.
TTS_PROVIDER=browser
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_BASE_URL=https://api.openai.com/v1
TTS_SPEED=1.0
